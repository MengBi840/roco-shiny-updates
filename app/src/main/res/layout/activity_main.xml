<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✦ 洛克精灵册 ✦"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1F6FD6" />

        <FrameLayout
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="⚙"
                android:textSize="22sp"
                android:textColor="#4A90E2"
                android:gravity="center" />

            <View
                android:id="@+id/settingsDot"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_dot"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnTheme"
            android:layout_width="44dp"
            android:layout_height="44dp">

            <TextView
                android:id="@+id/btnThemeIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="☀️"
                android:textSize="20sp"
                android:gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:id="@+id/pageTracking"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/encounterCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_panel"
                android:paddingLeft="12dp"
                android:paddingRight="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:id="@+id/tvEncPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_placeholder"
                            android:gravity="center"
                            android:textSize="17sp"
                            android:textColor="#7FB3E0"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/ivEncAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerInside"
                            android:contentDescription="@null"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvEncName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="本周大量出没"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#263238" />

                        <TextView
                            android:id="@+id/tvEncInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="日期 · 精灵球"
                            android:textSize="11sp"
                            android:textColor="#78909C" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEncExpand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▾ 查看全部"
                        android:textSize="12sp"
                        android:textColor="#4A90E2"
                        android:padding="8dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/merchantCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_panel"
                android:paddingLeft="12dp"
                android:paddingRight="8dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛒"
                    android:textSize="18sp"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="远行商人"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#263238" />

                    <TextView
                        android:id="@+id/tvMerchantStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="正在查询…"
                        android:textSize="11sp"
                        android:textColor="#78909C" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMerchantOpen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="查看商品 ›"
                    android:textSize="12sp"
                    android:textColor="#4A90E2"
                    android:padding="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/seasonPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:background="@drawable/bg_panel"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="赛季："
                        android:textSize="14sp"
                        android:textColor="#37474F" />

                    <Spinner
                        android:id="@+id/seasonSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:minHeight="36dp" />
                </LinearLayout>

                <View
                    android:id="@+id/vThemeLine"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="2dp"
                    android:background="#CFE3F5" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="解锁模式（点击精灵打勾 / 取消）"
                        android:textSize="12sp"
                        android:textColor="#78909C" />

                    <Switch
                        android:id="@+id/unlockSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTypeProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="已解锁 0 / 0"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#263238" />

                <TextView
                    android:id="@+id/tvSeasonProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="赛季总进度: 0 / 0 (0%)"
                    android:textSize="12sp"
                    android:textColor="#78909C" />

                <LinearLayout
                    android:id="@+id/tabContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPokemon"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/pageDex"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_panel"
        android:padding="6dp">

        <Button
            android:id="@+id/btnNav1"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="异色追踪"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnNav2"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="精灵图鉴"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
