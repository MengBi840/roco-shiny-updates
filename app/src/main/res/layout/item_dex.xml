<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_row"
    android:minHeight="70dp"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp"
    android:layout_marginLeft="2dp"
    android:layout_marginRight="2dp"
    android:layout_marginBottom="7dp">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="10dp">

        <TextView
            android:id="@+id/tvDexPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_placeholder"
            android:gravity="center"
            android:textSize="20sp"
            android:textColor="#7FB3E0"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivDexAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:contentDescription="@null"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDexNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NO.000"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#4A90E2"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvDexName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#263238"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivDexAttr1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvDexAttr1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#616161"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/ivDexAttr2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvDexAttr2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#616161"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvDexInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="11sp"
                android:textColor="#9AA8B6"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textSize="20sp"
        android:textColor="#B0C4DE"
        android:layout_marginStart="4dp" />

</LinearLayout>
